# P2PLearn Backend - Production Environment Template

# Port the Express server listens to (in production, Vercel/Railway binds this automatically)
PORT=5000

# MongoDB Atlas connection string URL
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/dbname?retryWrites=true&w=majority

# Secret key used for signing JWT login tokens (long random string)
JWT_SECRET=your_jwt_signing_secret_here

# Gmail credentials for OTP delivery and contact form notifications
EMAIL_USER=okarkele@gmail.com
EMAIL_PASS=zmmuheymbzivwvtg

# GitHub OAuth credentials for OAuth Login (retrieved from GitHub developer dashboard)
GITHUB_CLIENT_ID=Ov23liRMU5o9nG8jphYt
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# Target frontend URL allowed to access backend resources (CORS origin)
FRONTEND_URL=http://localhost:5173
